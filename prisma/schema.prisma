generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── User ────────────────────────────────────────────────────────────────────

model User {
  id          String  @id @default(cuid())
  supabaseId  String  @unique
  email       String  @unique
  name        String
  avatar      String?
  role        Role    @default(EMPLOYEE)
  isSuperAdmin Boolean @default(false)
  department  String?
  designation String?
  phone       String?
  bio         String?
  linkedinUrl String?
  twitterUrl  String?
  githubUrl   String?
  websiteUrl  String?
  joinedAt    DateTime @default(now())
  isActive    Boolean  @default(true)

  // Workspace relations
  ownedWorkspaces  Workspace[]         @relation("workspaceOwner")
  memberships      Membership[]
  sentInvitations  Invitation[]        @relation("invitedBy")
  createdInviteLinks WorkspaceInviteLink[] @relation("createdInviteLinks")

  // Feature relations (now workspace-scoped via their own workspaceId)
  tasks         Task[]         @relation("assignedTo")
  createdTasks  Task[]         @relation("createdBy")
  leaveRequests LeaveRequest[]
  messages      Message[]
  documents     Document[]
  notifications Notification[]
  conversationsAsOne Conversation[] @relation("conversationMemberOne")
  conversationsAsTwo Conversation[] @relation("conversationMemberTwo")

  // Private notes — never workspace-scoped
  notes Note[]

  // Global announcements (super admin only)
  globalAnnouncements GlobalAnnouncement[]

  // Feedback submissions
  feedbacks Feedback[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

// ─── Workspace ───────────────────────────────────────────────────────────────

model Workspace {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  logoUrl  String?
  ownerId  String
  owner    User    @relation("workspaceOwner", fields: [ownerId], references: [id])

  // Short alphanumeric code users can type to join (e.g. "XK9-TZ2")
  joinCode          String   @unique @default(cuid())
  joinCodeEnabled   Boolean  @default(true)

  memberships   Membership[]
  invitations   Invitation[]
  inviteLinks   WorkspaceInviteLink[]

  // Workspace-scoped data
  tasks         Task[]
  channels      Channel[]
  leaveRequests LeaveRequest[]
  documents     Document[]
  announcements Announcement[]
  notifications Notification[]
  conversations Conversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── WorkspaceInviteLink ─────────────────────────────────────────────────────
// Reusable shareable links — not tied to a specific email.
// Any authenticated user who visits the link can join.

model WorkspaceInviteLink {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User      @relation("createdInviteLinks", fields: [createdById], references: [id])
  token       String    @unique @default(cuid())
  label       String?                        // e.g. "Engineering team link"
  maxUses     Int?                           // null = unlimited
  useCount    Int       @default(0)
  expiresAt   DateTime?                      // null = never expires
  isActive    Boolean   @default(true)

  createdAt DateTime @default(now())
}

// ─── Membership ──────────────────────────────────────────────────────────────

model Membership {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  @@unique([userId, workspaceId])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
}

// ─── Invitation ──────────────────────────────────────────────────────────────

model Invitation {
  id          String           @id @default(cuid())
  email       String
  workspaceId String
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedById String
  invitedBy   User             @relation("invitedBy", fields: [invitedById], references: [id])
  token       String           @unique @default(cuid())
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime

  createdAt DateTime @default(now())

  @@unique([email, workspaceId])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

// ─── Note (private per-user) ─────────────────────────────────────────────────

model Note {
  id      String   @id @default(cuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title   String
  content String   @db.Text
  color   String?
  pinned  Boolean  @default(false)
  tags    String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Feedback (authenticated users, read by super admin) ─────────────────────

model Feedback {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String   @db.Text
  emoji     String   @default("💬")
  createdAt DateTime @default(now())
}

// ─── GlobalAnnouncement (system-wide, super admin only) ──────────────────────

model GlobalAnnouncement {
  id        String    @id @default(cuid())
  title     String
  body      String    @db.Text
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  priority  Priority  @default(MEDIUM)
  pinned    Boolean   @default(false)
  expiresAt DateTime?

  createdAt DateTime @default(now())
}

// ─── Task ────────────────────────────────────────────────────────────────────

model Task {
  id          String     @id @default(cuid())
  workspaceId String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?
  assigneeId  String?
  assignee    User?      @relation("assignedTo", fields: [assigneeId], references: [id])
  creatorId   String
  creator     User       @relation("createdBy", fields: [creatorId], references: [id])
  tags        String[]
  attachments String[]
  order       Int        @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ─── Leave ───────────────────────────────────────────────────────────────────

model LeaveRequest {
  id          String      @id @default(cuid())
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  type        LeaveType
  startDate   DateTime
  endDate     DateTime
  reason      String
  status      LeaveStatus @default(PENDING)
  approvedBy  String?
  comments    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum LeaveType {
  SICK
  CASUAL
  EARNED
  MATERNITY
  PATERNITY
  UNPAID
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// ─── Chat ────────────────────────────────────────────────────────────────────

model Message {
  id             String       @id @default(cuid())
  // Either channelId OR conversationId must be set (not both)
  channelId      String?
  channel        Channel?     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  content        String
  type           MessageType  @default(TEXT)
  fileUrl        String?

  createdAt DateTime  @default(now())
  editedAt  DateTime?
}

enum MessageType {
  TEXT
  IMAGE
  FILE
}

model Channel {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isPrivate   Boolean   @default(false)
  messages    Message[]

  createdAt DateTime @default(now())

  @@unique([workspaceId, name])
}

// ─── Conversation (1-on-1 DMs) ───────────────────────────────────────────────

model Conversation {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  memberOneId String
  memberOne   User      @relation("conversationMemberOne", fields: [memberOneId], references: [id])
  memberTwoId String
  memberTwo   User      @relation("conversationMemberTwo", fields: [memberTwoId], references: [id])
  messages    Message[]

  createdAt DateTime @default(now())

  // Prevent duplicate conversations for the same pair in the same workspace
  @@unique([workspaceId, memberOneId, memberTwoId])
}

// ─── Document ────────────────────────────────────────────────────────────────

model Document {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title       String
  content     String    @db.Text
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])
  isPublic    Boolean   @default(false)
  tags        String[]
  fileUrl     String?
  version     Int       @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Announcement ────────────────────────────────────────────────────────────

model Announcement {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title       String
  body        String    @db.Text
  authorId    String
  priority    Priority  @default(MEDIUM)
  pinned      Boolean   @default(false)
  expiresAt   DateTime?

  createdAt DateTime @default(now())
}

// ─── Notification ────────────────────────────────────────────────────────────

model Notification {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  title       String
  body        String
  type        String
  read        Boolean   @default(false)
  link        String?

  createdAt DateTime @default(now())
}
